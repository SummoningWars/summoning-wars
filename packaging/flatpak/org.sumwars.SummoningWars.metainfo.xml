<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>org.sumwars.SummoningWars</id>
  <name>Summoning Wars</name>
  <summary>Open source 3D action role-playing game with single- and multiplayer</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <developer id="org.sumwars">
    <name>The Summoning Wars Team</name>
  </developer>

  <description>
    <p>
      Summoning Wars is an open source action role-playing game set in a dark
      fantasy world. It can be played alone or with up to eight players in
      multiplayer, and features four playable classes, dozens of monsters and
      hundreds of items.
    </p>
    <p>Features:</p>
    <ul>
      <li>Single-player campaign and networked multiplayer for up to 8 players</li>
      <li>Four classes (archer, mage, priest and warrior), each with 24 skills</li>
      <li>Dozens of monsters and hundreds of items to find, buy and sell</li>
      <li>3D graphics with a freely rotatable camera</li>
      <li>A dark story told through cutscenes, scripted events and side quests</li>
    </ul>
  </description>

  <launchable type="desktop-id">org.sumwars.SummoningWars.desktop</launchable>

